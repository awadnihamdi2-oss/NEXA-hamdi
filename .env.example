# ==============================================================================
# NEXA QUANT INTELLIGENCE — Server-Side Environment Configuration Template
# ==============================================================================
# Copy to .env for local runs or inject via Google AI Studio Secrets / Cloud Run.
# NEVER commit real API keys, session secrets, or passwords to version control.
# NEVER expose any provider secret in client-side VITE_* variables.

# --- 1. Core AI Providers (Free-First Routing Tier) ---
# Primary Google Gemini API key (used by @google/genai on server only).
# Optional for server boot/offline simulation; required for live GEMINI model calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenRouter key (routing enforces :free models, $0.00 pricing, and text->text modality).
OPENROUTER_API_KEY=""

# Groq LPU free-tier key.
GROQ_API_KEY=""

# NVIDIA NIM free-tier key.
NVIDIA_API_KEY=""

# --- 2. Optional Metered / Paid AI Providers (Disabled by Default) ---
# Only active if explicitly enabled AND NEXA_PAID_FALLBACK_ALLOWED="true" + Admin UI toggle.
DEEPSEEK_API_KEY=""
QWEN_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- 3. Database & Session Security ---
# Persistent directory for SQLite backups and Phase 7 client exports (defaults to dirname of NEXA_DB_PATH or ./data).
NEXA_DATA_DIR="./data"

# SQLite WAL database file path (parent directory created automatically on boot).
NEXA_DB_PATH="./data/nexa_genesis.sqlite3"

# REQUIRED in production: HMAC-SHA256 session token signing key (minimum 32 cryptographically random chars).
# Generate locally via: openssl rand -base64 36
NEXA_SESSION_SECRET=""

# REQUIRED for 24/7 Cloud Scheduler authenticated HTTP triggers (POST /api/commerce/schedules/run-due).
# Minimum 24 cryptographically random chars (e.g. openssl rand -hex 24).
NEXA_SCHEDULER_TOKEN=""

# REQUIRED in production: Initial seeded RBAC password for admin/operator/researcher/viewer (>= 12 chars non-default).
# Both NEXA_ADMIN_PASSWORD (recommended) and legacy alias NEXA_DEFAULT_ADMIN_PASSWORD are accepted.
NEXA_ADMIN_PASSWORD=""
NEXA_DEFAULT_ADMIN_PASSWORD=""

# --- 4. Safety & Execution Guardrails (Must Stay "false") ---
# Prevents automatic fallback from free models to paid providers.
NEXA_PAID_FALLBACK_ALLOWED="false"

# Enforces Quant Paper-Only simulation; live capital trading is locked in code.
NEXA_LIVE_TRADING_ENABLED="false"

# Keeps external commerce publishing/payments disabled behind human approval gates.
NEXA_EXTERNAL_COMMERCE_ENABLED="false"

# --- 5. Runtime & Hosting Environment ---
# HTTP server listening port (Google AI Studio / Cloud Run expects 3000 in dev preview).
PORT="3000"

# Set to "production" when running compiled dist/ bundle via `npm start`.
NODE_ENV="development"

# Public application URL (used as HTTP-Referer on OpenRouter requests; injected by AI Studio).
APP_URL="http://localhost:3000"

# Set "true" in AI Studio container to disable Vite HMR WebSockets.
DISABLE_HMR="true"

# --- 6. Optional Free Remote Persistence Sync (Private GitHub Gist, $0) ---
# Enables automatic verified SQLite snapshot download/upload across ephemeral free container restarts.
NEXA_BACKUP_GIST_TOKEN=""
NEXA_BACKUP_GIST_ID=""

